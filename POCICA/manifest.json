{
  "manifest_version": 3,
  "name": "Guard Anti Judol - POCICO",
  "version": "1.0",
  "description": "Dibuat oleh Staff POCICO untuk melindungi Gen Z Desa POCICO dari judi online",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
